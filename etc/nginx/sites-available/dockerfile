FROM node:22

RUN apt update && apt install -y nginx

WORKDIR /app

COPY backend/ .

RUN npm install

COPY frontend/ /var/www/html/

RUN echo "server { listen 80; root /var/www/html; index index.html; location / { try_files \$uri \$uri/ =404; } location /api/ { proxy_pass http://127.0.0.1:3000; } }" > /etc/nginx/sites-available/default

EXPOSE 80

CMD ["sh", "-c", "node server.js & nginx -g 'daemon off;'"]

  Then run commands
  sudo docker build -t om-app .
  sudo docker push omt27/om27:latest
